# Server Environment
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Database & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/errorpulse
REDIS_URL=redis://localhost:6379

# Security & Secrets
SESSION_SECRET=dev_session_secret_32_characters_minimum_required
