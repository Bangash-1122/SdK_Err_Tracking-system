# Server Environment
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Database & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/errorpulse
REDIS_URL=redis://localhost:6379

# Security & Secrets
SESSION_SECRET=replace_with_a_secure_session_secret
CSRF_SECRET=replace_with_a_secure_csrf_secret
ENCRYPTION_KEY_HEX=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# S3 Storage Configuration
S3_BUCKET_NAME=errorpulse-attachments
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

